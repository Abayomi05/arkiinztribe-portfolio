# Canonical site URL, used for metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend - project brief delivery
RESEND_API_KEY=""
PROJECT_BRIEF_TO_EMAIL=""
PROJECT_BRIEF_FROM_EMAIL="ARKIINZTRIBE <onboarding@resend.dev>"

# Neon Postgres. Leave blank to run ARK as a local session without persistence.
DATABASE_URL=""

# Comma-separated extra origins allowed during `next dev` (e.g. testing on a LAN)
ALLOWED_DEV_ORIGINS="localhost,127.0.0.1"

# Force the Secure attribute on the ARK session cookie. Leave unset to
# derive it from the request (x-forwarded-proto, then the URL scheme).
# Only needed behind a proxy that does not send x-forwarded-proto.
ARK_SECURE_COOKIES=
